# Copy to .env and fill in. Never commit .env.

# MySQL: use a read-only user with SELECT on the business tables only (see README)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=vanna_readonly
MYSQL_PASSWORD=change-me

# Query guard rails
QUERY_TIMEOUT_SECONDS=30
MAX_RESULT_ROWS=5000

# Which LLM writes the SQL: ollama (local, nothing leaves this machine) or groq (cloud API)
LLM_PROVIDER=ollama

# Groq: get a key at https://console.groq.com/keys
# Sends schema, business rules, examples and questions to Groq (not query results)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60

# Local LLM via Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=240

# Vanna's training memory
VECTOR_STORE_PATH=./vector_store
RETRIEVAL_RESULTS=10

# Web app. 127.0.0.1 = this machine only; 0.0.0.0 = whole network (add auth/proxy first)
APP_HOST=127.0.0.1
APP_PORT=8084
APP_TITLE=Ask the database
# Ollama is local, so data stays on this machine either way. True lets the model read
# query results to write summaries and run exploratory queries.
ALLOW_LLM_TO_SEE_DATA=false
SHOW_TRAINING_DATA=true

# REST API for the React frontend (python api.py)
API_HOST=127.0.0.1
API_PORT=8000
# Set to require an X-API-Key header on every request (recommended once others use it)
API_KEY=
# React dev servers allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RESULT_CACHE_MINUTES=60
